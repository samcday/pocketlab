#!/usr/bin/env bash
set -euo pipefail

candidate_file=/usr/lib/pocketlab/dracut-force-drivers.list
dracut_conf=/etc/dracut.conf.d/10-sdm845-fajita-force-drivers.conf
missing_file=/var/lib/pocketlab/dracut-force-drivers.missing
device_services=(rmtfs.service tqftpserv.service)

trim() {
    local value="$1"
    value="${value%%#*}"
    value="${value//$'\t'/ }"
    value="${value//$'\r'/ }"
    value="${value#"${value%%[! ]*}"}"
    value="${value%"${value##*[! ]}"}"
    printf '%s' "$value"
}

mapfile -t kernel_versions < <(
    for modules_dir in /usr/lib/modules/*; do
        [[ -d "$modules_dir" ]] || continue
        [[ -e "$modules_dir/vmlinuz" ]] || continue
        printf '%s\n' "${modules_dir##*/}"
    done | sort -V
)

if ((${#kernel_versions[@]} == 0)); then
    echo "No Fedora kernel with /usr/lib/modules/<version>/vmlinuz was installed" >&2
    exit 1
fi

if [[ ! -f "$candidate_file" ]]; then
    echo "Missing SDM845 dracut driver inventory: $candidate_file" >&2
    exit 1
fi

drivers=()
missing=()
while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
    driver="$(trim "$raw_line")"
    [[ -n "$driver" ]] || continue

    present=yes
    for kver in "${kernel_versions[@]}"; do
        if ! modprobe --set-version "$kver" --show-depends "$driver" >/dev/null 2>&1; then
            present=no
            break
        fi
    done

    if [[ "$present" == yes ]]; then
        drivers+=("${driver//-/_}")
    else
        missing+=("$driver")
    fi
done < "$candidate_file"

if ((${#drivers[@]} == 0)); then
    echo "None of the SDM845 dracut driver candidates exist in the installed kernel" >&2
    exit 1
fi

mkdir -p /etc/dracut.conf.d /var/lib/pocketlab
{
    echo "# Generated by mkosi.finalize.chroot from $candidate_file."
    echo "# Missing candidates are recorded in $missing_file."
    printf 'force_drivers+="'
    printf ' %s' "${drivers[@]}"
    printf ' "\n'
} > "$dracut_conf"

printf '%s\n' "${missing[@]}" > "$missing_file"

systemctl --root=/ preset "${device_services[@]}"
for service in "${device_services[@]}"; do
    systemctl --root=/ is-enabled "$service" >/dev/null || { echo "$service is not enabled" >&2; exit 1; }
done

mkdir -p /boot/loader/entries
printf 'type1\n' > /boot/loader/entries.srel
find /boot -mindepth 1 -maxdepth 1 ! -name loader -exec rm -rf -- {} +
find /boot/loader/entries -type f -name '*.conf' -delete

for kver in "${kernel_versions[@]}"; do
    kernel_image="/usr/lib/modules/$kver/vmlinuz"
    depmod -a "$kver"
    BOOT_ROOT=/boot \
        BOOT_MNT=/boot \
        KERNEL_INSTALL_LAYOUT=bls \
        KERNEL_INSTALL_INITRD_GENERATOR=dracut \
        KERNEL_INSTALL_VERBOSE=1 \
        kernel-install add "$kver" "$kernel_image"
done

shopt -s nullglob
entries=(/boot/loader/entries/*.conf)
if ((${#entries[@]} == 0)); then
    echo "kernel-install did not create any BLS entries" >&2
    exit 1
fi

for entry in "${entries[@]}"; do
    grep -q '^linux[[:space:]]' "$entry" || { echo "BLS entry missing linux: $entry" >&2; exit 1; }
    grep -q '^initrd[[:space:]]' "$entry" || { echo "BLS entry missing initrd: $entry" >&2; exit 1; }
    grep -q '^devicetree[[:space:]]' "$entry" || { echo "BLS entry missing devicetree: $entry" >&2; exit 1; }
    grep -q 'root=LABEL=fedora' "$entry" || { echo "BLS entry missing root=LABEL=fedora: $entry" >&2; exit 1; }
done
